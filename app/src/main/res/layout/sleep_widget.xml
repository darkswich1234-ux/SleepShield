<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_moon"
        android:contentDescription="@string/app_name"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true" />

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_toEndOf="@id/widget_icon"
        android:layout_marginStart="8dp"
        android:layout_alignTop="@id/widget_icon"
        android:layout_alignBottom="@id/widget_icon"
        android:gravity="center_vertical" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shield is Active"
        android:textColor="#FFB7A9FF"
        android:textSize="11sp"
        android:layout_below="@id/widget_icon"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/widget_time_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/widget_status"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bedtime"
                android:textColor="#FF9FAAC3"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_bedtime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 PM"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Arrow"
            android:layout_marginHorizontal="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wake At"
                android:textColor="#FF9FAAC3"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/widget_wake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5:18 AM"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_power"
        android:scaleType="centerInside"
        android:contentDescription="Toggle Shield" />

</RelativeLayout>
